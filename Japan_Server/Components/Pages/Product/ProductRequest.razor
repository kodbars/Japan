@inject HttpClient Http
@inject ILogger<Product> Logger
@inject IJSRuntime JSRuntime

<ScrollToTopButton />

<NavMenu Categories="@_externalMenu?.itemCategories" OnCategorySelected="ScrollToCategory" />

<MudGrid Spacing="7" Justify="Justify.Center">
    @if (_externalMenu != null)
    {
        foreach (var row in _externalMenu.itemCategories)
        {
            string categoryId = "category-" + row.name.Replace(" ", "-").Replace(".", "-").ToLowerInvariant();

            <MudItem id="@categoryId" xs="12">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="font-weight-bold" Style="margin: 16px 0 8px 0;">
                    @row.name
                </MudText>
            </MudItem>
            foreach (var item in row.items)
            {
                <Product ProductName="@item.name" DialogText="@item.description" Src="@item.itemSizes[0].buttonImageUrl" />
            }

        }
    }

</MudGrid>


@code {
    private string DialogText = string.Empty;
    private string Src = string.Empty;
    private Root? _externalMenu;
    protected override async Task OnInitializedAsync()
    {
        await LoadMenuAsync();
    }

    private async Task LoadMenuAsync()
    {
        try
        {
            // 🎯 POST к вашему контроллеру
            var response = await Http.PostAsJsonAsync("api/test/externalMenu", new { });
            response.EnsureSuccessStatusCode();

            using var responseStream = await response.Content.ReadAsStreamAsync();
            var externalMenu = await System.Text.Json.JsonSerializer.DeserializeAsync<Root>(
                responseStream,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
            if (externalMenu != null)
            {
                _externalMenu = externalMenu;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки меню");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ScrollToCategory(string categoryName)
    {
        string id = "category-" + categoryName.Replace(" ", "-").Replace(".", "-").ToLowerInvariant();
        await JSRuntime.InvokeVoidAsync("scrollToElement", id);
    }
}
