<MudDialog>
    <TitleContent>
        Информация о продукте:
    </TitleContent>
    <DialogContent>
        @DialogContent
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public string DialogContent { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
}
