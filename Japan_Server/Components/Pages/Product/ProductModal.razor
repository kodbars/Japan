@inject ILocalStorageService LocalStorageService
<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <h2>Информация о продукте:</h2>
            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                           OnClick="Submit"
                           Color="Color.Default"
                           Size="Size.Medium" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="product-container">

            @* Левая часть — изображение *@
            <div class="product-image">
                <MudImage Height="400"
                          Width="400"
                          Src="@(ImageRoot == null ? "images/default.png" : ImageRoot)"
                          Style="object-fit: cover; border-radius: 12px;" />
            </div>

            @* Правая часть — информация *@
            <div class="product-info">

                <div class="product-description">
                    @DialogText
                </div>

                <div class="product-price">
                    <MudButton Variant="Variant.Filled"
                               Class="custom-button" onclick="@SumPrice">
                        @ProductPrice ₽
                    </MudButton>
                </div>

            </div>
        </div>
    </DialogContent>

</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    public string DialogText { get; set; }
    public double ProductPrice { get; set; }
    public string? ImageRoot { get; set; }

    [Parameter]
    public Item? Item { get; set; }

    [CascadingParameter]
    public _StateСookie stateСookie { get; set; } = null!;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void SumPrice()
    {
        stateСookie.SumPrice += ProductPrice;
    }

    protected override async Task OnInitializedAsync()
    {
        DialogText = Item.description;
        ImageRoot = Item.itemSizes[0].buttonImageUrl;
        ProductPrice = (double) Item.itemSizes[0].prices[0]?.price;
    }


}
