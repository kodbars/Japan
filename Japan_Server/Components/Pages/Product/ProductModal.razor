@inject ILocalStorageService LocalStorageService
<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <h2>Информация о продукте:</h2>
            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                           OnClick="Submit"
                           Color="Color.Default"
                           Size="Size.Medium" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="product-container">

            @* Левая часть — изображение *@
            <div class="product-image">
                <MudImage Height="400"
                          Width="400"
                          Src="@(_imageRoot == null ? "images/default.png" : _imageRoot)"
                          Style="object-fit: cover; border-radius: 12px;" />
            </div>

            @* Правая часть — информация *@
            <div class="product-info">

                <div class="product-description">
                    @_dialogText
                </div>

                <div class="product-price">
                    <MudButton Variant="Variant.Filled"
                               Class="custom-button" onclick="@AddBasket">
                        @_productPrice ₽
                    </MudButton>
                </div>

            </div>
        </div>
    </DialogContent>

</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private string _skyID { get; set; }
    private string _dialogText { get; set; }
    private double _productPrice { get; set; }
    private string? _imageRoot { get; set; }
    private string? _productName { get; set; }

    [CascadingParameter]
    public _StateСookie _stateCookie { get; set; } = null!;

    [Parameter]
    public Item? Item { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private async Task AddBasket()
    {
        var basket = new Basket()
        {
            SkyID = _skyID,
            ImageRoot = _imageRoot,
            ProductName = _productName,
            ProductPrice = _productPrice
        };
        await _stateCookie.AddBasketAsync(basket);
    }

    protected override async Task OnInitializedAsync()
    {

        _skyID = Item.sku;
        _productName = Item.name;
        _dialogText = Item.description;
        _imageRoot = Item.itemSizes[0].buttonImageUrl;
        _productPrice = (double)Item.itemSizes[0].prices[0]?.price;
    }


}
