@inject HttpClient Http
@inject IDialogService DialogService
@inject ILogger<Product> Logger

<MudItem>
    <MudPaper Height="320px" Width="260px" Style="position: relative;">
        
        <!-- Кнопка Info в правом верхнем углу -->
        <MudIconButton Icon="@Icons.Material.Filled.Info"
                       @onclick="OpenDialogAsync"
                       Variant="Variant.Filled"
                       Style="position: absolute; top: 8px; right: 8px; z-index: 10;"
                       Color="Color.Default"
                       Size="Size.Small" />
        
        
        <div Style="flex: 1; min-height: 0; position: relative;">
            <MudImage Height="260" Width="260" Src="https://16a9564f-f8ec-42ba-a998-3027aa809e50.selstorage.ru/demobars/84414/images/items/cd393fabfd308b52ba4b1eb2170c9427.WEBP" Style="object-fit: cover;" />
        </div>

        <MudToolBar Style="height: 60px; justify-content: center; gap: 4px;">
            <MudIconButton Icon="@Icons.Material.Outlined.Remove" Disabled="@Disabled" @onclick="MinusOnePositionAsync" Size="Size.Small" />
            <MudNumericField HideSpinButtons="true" @bind-Value="IntValue" Label="@AMOUNT" Variant="Variant.Text" Min="0" Style="width: 70px;" InputClass="text-center" />
            <MudIconButton Icon="@Icons.Material.Outlined.Add" @onclick="PlusOnePositionAsync" Size="Size.Small" />
        </MudToolBar>
    </MudPaper>
</MudItem>

@code {
    private int IntValue { get; set; } = 0;
    private const string AMOUNT = "Количество";
    private bool Disabled = true;
    private string DialogText = "Какой-то текст о продукте";

    private Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
    
        // Создаем параметры для диалога
        var parameters = new DialogParameters
    {
        { nameof(ProductInfo.DialogContent), DialogText }
    };
    
        return DialogService.ShowAsync<ProductInfo>("Simple Dialog", parameters, options);
    }

    private async Task PlusOnePositionAsync()
    {
        IntValue++;
        if (IntValue > 0)
        {
            Disabled = false;
        }
    }
    private async Task MinusOnePositionAsync()
    {
        IntValue--;
        if (IntValue < 1)
        {
            Disabled = true;
        }
    }

}
