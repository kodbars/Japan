@inject HttpClient Http
@inject IDialogService DialogService
@inject ILogger<Product> Logger

<MudItem>
    <MudPaper Elevation="2" Class="product-card" Style="border-radius: 16px; overflow: hidden; height: 320px; width: 260px; position: relative; display: flex; flex-direction: column;">

        <!-- Кнопка Info в правом верхнем углу -->
        <MudIconButton Icon="@Icons.Material.Filled.Info"
                       @onclick="OpenDialogAsync"
                       Variant="Variant.Filled"
                       Style="position: absolute; top: 16px; right: 20px; z-index: 10;"
                       Color="Color.Default"
                       Size="Size.Small" />

        
        <div Style="flex: 1; min-height: 0; position: relative; margin: 4px 8px 0 8px; border-radius: 12px; overflow: hidden; box-shadow: 0 0 12px rgba(0,0,0,0.08);">
            @if (Src == null)
            {
                <MudImage Height="260" Width="260" Src="images/default.png" Style="object-fit: cover; border-radius: 12px;" />
            }
            else
            {
                <MudImage Height="260" Width="260" Src="@Src" Style="object-fit: cover; border-radius: 12px;" />
            }
        </div>



        <div Style="padding: 8px 12px 0 12px;
            font-weight: 600;
            font-size: 18px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-shrink: 0;">
            @ProductName
        </div>

        <div style="display: flex; align-items: center; gap: 8px; margin-top: auto; justify-content: center;">
            <MudIconButton Icon="@Icons.Material.Outlined.ExposureNeg1" Disabled="@Disabled" @onclick="MinusOnePositionAsync" Size="Size.Medium" />
            <input type="number"
                   class="no-spinners"
                   @bind="IntValue"
                   @bind:event="oninput"
                   min="0"
                   style="width: 50px;
            text-align: center;
            font-weight: 600;
            font-size: 18px;
            padding: 4px 0;
            margin: 0;
            border: none;
            background: transparent;
            outline: none;
            box-shadow: none;" />
            <MudIconButton Icon="@Icons.Material.Filled.ExposurePlus1" @onclick="PlusOnePositionAsync" Size="Size.Medium" />
        </div>
    </MudPaper>
</MudItem>

@code {
    private int IntValue { get; set; } = 0;
    private bool Disabled = true;
    [Parameter]
    public string DialogText { get; set; } = "Информация о продукте";
    [Parameter]
    public string Src { get; set; } = "images/default.png";
    [Parameter]
    public string ProductName { get; set; }

    private Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        // Создаем параметры для диалога
        var parameters = new DialogParameters
        {
            { nameof(ProductInfo.DialogContent), DialogText }
        };

        return DialogService.ShowAsync<ProductInfo>("Simple Dialog", parameters, options);
    }

    private async Task PlusOnePositionAsync()
    {
        IntValue++;
        if (IntValue > 0)
        {
            Disabled = false;
        }
    }
    private async Task MinusOnePositionAsync()
    {
        IntValue--;
        if (IntValue < 1)
        {
            Disabled = true;
        }
    }

}
