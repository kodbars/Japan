@inject HttpClient Http
@inject IDialogService DialogService
@inject ILogger<Product> Logger

<MudItem>
    <MudPaper Elevation="2" Class="product-card" Style="border-radius: 16px; overflow: hidden; height: 320px; width: 260px; position: relative; display: flex; flex-direction: column;">

        <!-- Кнопка Info в правом верхнем углу -->
        <MudIconButton Icon="@Icons.Material.Filled.Info"
                       @onclick="OpenDialogAsync"
                       Variant="Variant.Filled"
                       Style="position: absolute; top: 16px; right: 20px; z-index: 10;"
                       Color="Color.Default"
                       Size="Size.Small" />

        
        <div Style="flex: 1; min-height: 0; position: relative; margin: 4px 8px 0 8px; border-radius: 12px; overflow: hidden; box-shadow: 0 0 12px rgba(0,0,0,0.08);">
            <MudImage Height="260" Width="260" Src="@(ImageRoot == null ? "images/default.png" : ImageRoot)" Style="object-fit: cover; border-radius: 12px;" />
        </div>


        <div Style="padding: 8px 12px 0 12px;
            font-weight: 600;
            font-size: 18px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-shrink: 0;">
            @ProductName
        </div>

        <MudButton @onclick="OpenDialogAsync">@ProductPrice ₽</MudButton>
    </MudPaper>
</MudItem>

@code {
    [Parameter]
    public Item? Item { get; set; }
    private string DialogText { get; set; } = "Информация о продукте";
    private string ImageRoot { get; set; } = "images/default.png";
    private string? ProductName { get; set; }
    private double? ProductPrice { get; set; }


    protected override async Task OnInitializedAsync()
    {
        DialogText = Item.description;
        ImageRoot = Item.itemSizes[0].buttonImageUrl;
        ProductName = Item.name;
        ProductPrice = Item.itemSizes[0].prices[0]?.price;
    }

    private Task OpenDialogAsync()
    {
        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true
        };

        var parameters = new DialogParameters
    {
        { nameof(ProductModal.Item), Item }
    };

        return DialogService.ShowAsync<ProductModal>(
            "Simple Dialog",
            parameters,
            options
        );
    }

}
