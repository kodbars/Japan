<MudDrawer Open="@Open"
           OpenChanged="OpenChanged"
           Anchor="@Anchor.End"
           Elevation="1"
           Variant="@DrawerVariant.Temporary"
           OverlayAutoClose="true"
           Width="400px">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Корзина</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                       OnClick="@(() => OpenChanged.InvokeAsync(false))"
                       Color="Color.Default"
                       Size="Size.Medium" />
    </MudNavMenu>
    @foreach (var item in stateСookie.GetBaskets())
    {
        <BasketItem @key="item.SkyID" Product="@item"></BasketItem>
    }
    </MudDrawer>

@code {
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }
    [CascadingParameter]
    public _StateСookie stateСookie { get; set; } = null!;

}