
<MudDrawer Open="@Open"
           OpenChanged="OpenChanged"
           Anchor="@Anchor.End"
           Elevation="1"
           Variant="@DrawerVariant.Temporary"
           OverlayAutoClose="true"
           Width="400px"
           Class="basket-drawer">

    @* Верхний блок *@
    <div class="basket-header">
        <MudText Typo="Typo.h6">
            Корзина
        </MudText>

        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       OnClick="@(() => OpenChanged.InvokeAsync(false))"
                       Color="Color.Default"
                       Size="Size.Medium" />
    </div>

    <MudDivider />

    @* Центральный блок *@
    <div class="basket-content">

        @foreach (var item in stateСookie.GetBaskets())
        {
            <BasketItem @key="item.SkyID"
                        Product="@item" />
        }

    </div>

    @* Нижний блок *@
    <div class="basket-footer">

        <MudDivider />

        <div class="basket-total">
            <MudText Typo="Typo.h6">
                Итого:
            </MudText>

            <MudText Typo="Typo.h6">
                @stateСookie.SumPrice() ₽
            </MudText>
        </div>

        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   FullWidth="true">
            Оформить заказ
        </MudButton>

    </div>

</MudDrawer>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [CascadingParameter]
    public _StateСookie stateСookie { get; set; } = null!;
}
