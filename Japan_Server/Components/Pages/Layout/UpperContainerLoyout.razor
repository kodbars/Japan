@inject NavigationManager _navigationManager
@inject IJSRuntime JSRuntime

<MudPaper Height="180px" Width="100%" Class="banner-paper" Style="border-bottom: 2px solid #e0e0e0;">
    <MudContainer MaxWidth="MaxWidth.False" Fixed="true" Class="banner-container">
        
        <!-- 🔹 Изображение: прижато к низу -->
        <MudImage Src="images/Japan.png"
                  Height="115"
                  @onclick="ScrollToTop"
                  Alt="Логотип"
                  Class="rounded-lg ml-4 banner-image" />
        
        <!-- 🔹 Текстовый блок: центрирован по вертикали -->
        <div Class="banner-text-wrapper">
            <MudText Typo="Typo.body1" Class="banner-text-main">
                Сеть №1 в России <br />
                <MudElement Class="banner-text-highlight">
                    по количеству ресторанов японской кухни
                </MudElement>
            </MudText>
            <MudText Typo="Typo.caption" Class="banner-text-delivery">
                Доставка 60 минут или подарим бесплатный ролл
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.LocalDining" IconSize="@Size.Large" Size="@Size.Small" Color="Color.Warning" Style="margin-left: auto; margin-right: 100px; border-radius: 20px; height: 50px; margin-top: 25px;">Корзина</MudButton>
    </MudContainer>
</MudPaper>

@code {
    private bool IsVisible = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Подписываемся на событие прокрутки через JS
            await JSRuntime.InvokeVoidAsync("scrollToTopInterop.init", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void OnScroll(bool isVisible)
    {
        IsVisible = isVisible;
        StateHasChanged();
    }

    private async Task ScrollToTop()
    {
        _navigationManager.NavigateTo("/");
        await JSRuntime.InvokeVoidAsync("scrollToTopInterop.scrollToTop");
    }
}