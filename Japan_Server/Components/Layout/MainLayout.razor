@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <Basket Open="_basketOpen"
            OpenChanged="OnBasketOpenChanged" />

    <AppBar />

    <MudMainContent Style="padding: 3px; margin: 0px; margin-bottom: 30px;">

        <div class="top-header"
             style="position: sticky; top: 0; z-index: 10; background: #f5f5f5; border-bottom: 1px solid #ddd;">

            <UpperContainerLoyout OnBasketClick="OpenBasket" />

        </div>

        @Body

        <div class="footer-wrapper">
            <LowerContainerLoyout />
        </div>

    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _basketOpen;

    private void OnBasketOpenChanged(bool open)
    {
        _basketOpen = open;
    }

    private Task OpenBasket()
    {
        _basketOpen = true;
        return Task.CompletedTask;
    }

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Gray.Lighten5,
            AppbarBackground = Colors.Gray.Lighten5,
            AppbarText = "#000000"
        },
        LayoutProperties = new LayoutProperties()
        {
            AppbarHeight = "48px"
        }
    };
}