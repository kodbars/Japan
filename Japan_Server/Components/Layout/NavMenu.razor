<div class="d-flex justify-center" style="padding: 10px;">
    <MudButtonGroup Variant="Variant.Filled">
        @if (Categories != null && Categories.Any())
        {
            @foreach (var item in Categories)
            {
                <MudButton @onclick="() => OnCategoryClick(item.name)">@item.name</MudButton>
            }
        }
    </MudButtonGroup>
</div>

@code {
    [Parameter]
    public List<ItemCategory>? Categories { get; set; }

    [Parameter]
    public EventCallback<string> OnCategorySelected { get; set; }

    private async Task OnCategoryClick(string categoryName)
    {
        if (OnCategorySelected.HasDelegate)
        {
            await OnCategorySelected.InvokeAsync(categoryName);
        }
    }
}