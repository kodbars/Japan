@using Japan_Server.Services.IServices
@inject ILocalStorageService LocalStorageService

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    internal const string StateKeyNameBasket = "Basket";
    private string _imgRoot = "images/default.png";
    private double _sumPrice;
    List<Basket>? _baskets;

    public void AddBasket(Basket basket)
    {
        _baskets.Add(basket);
        var json = JsonSerializer.Serialize(_baskets);
        LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
        StateHasChanged();
    }

    public void RemoveBasket(Basket basket)
    {

        var json = JsonSerializer.Serialize(_baskets);
        LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
    }

    public List<Basket> GeBbaskets()
    {
        return _baskets ?? new();
    }

    public double SumPrice()
    {
        if (_baskets != null)
        {
            _sumPrice = _baskets.Sum(x => x.ProductPrice);
            return _sumPrice;
        }
        return 0d;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var stateBasket = await LocalStorageService.GetStringAsync(StateKeyNameBasket);
        _baskets = JsonSerializer.Deserialize<List<Basket>>(stateBasket) ?? new();
        if (_baskets != null)
        {
            _sumPrice = _baskets.Sum(x => x.ProductPrice);
            StateHasChanged();
        }
    }
}