@using Japan_Server.Services.IServices
@inject ILocalStorageService LocalStorageService

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    internal const string StateKeyNameBasket = "Basket";
    private string _imgRoot = "images/default.png";
    private double _sumPrice;
    private List<BasketModels> _baskets = new();

    public async Task AddBasketAsync(BasketModels basket)
    {
        var basketIndex = _baskets.FindIndex(x => x.SkyID == basket.SkyID);
        if (basketIndex != -1)
        {
            _baskets[basketIndex].Amount += 1;
            var json = JsonSerializer.Serialize(_baskets);
            await LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
        } else
        {
            _baskets.Add(basket);
            var json = JsonSerializer.Serialize(_baskets);
            await LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
        }
        StateHasChanged();
    }

    public async Task<BasketModels> AmountDecrease(BasketModels basket)
    {
        var basketIndex = _baskets.FindIndex(x => x.SkyID == basket.SkyID);
        if (basketIndex != -1)
        {
            if (_baskets[basketIndex].Amount - 1 < 1)
            {
                RemoveBasket(_baskets[basketIndex]);
                return null;
            }
            _baskets[basketIndex].Amount -= 1;
            var json = JsonSerializer.Serialize(_baskets);
            await LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
            StateHasChanged();
            return _baskets[basketIndex];
        }
        return null;
    }

    public async Task<BasketModels> AmountIncrease(BasketModels basket)
    {
        var basketIndex = _baskets.FindIndex(x => x.SkyID == basket.SkyID);
        if (basketIndex != -1)
        {
            _baskets[basketIndex].Amount += 1;
            var json = JsonSerializer.Serialize(_baskets);
            await LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
            StateHasChanged();
            return _baskets[basketIndex];
        }
        return null;
    }


    public void RemoveBasket(BasketModels basket)
    {
        int indexBasket = _baskets.FindIndex(x => x.Amount.Equals(basket.Amount));
        if (indexBasket != 0)
        {
            _baskets.RemoveAt(indexBasket);
            var json = JsonSerializer.Serialize(_baskets);
            LocalStorageService.SetStringAsync(StateKeyNameBasket, json);
            StateHasChanged();
        }
    }

    public List<BasketModels> GeBbaskets()
    {
        return _baskets ?? new();
    }

    public double SumPrice()
    {
        if (_baskets != null)
        {
            _sumPrice = _baskets.Sum(x => x.ProductPrice*x.Amount);
            return _sumPrice;
        }
        return 0d;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stateBasket = await LocalStorageService.GetStringAsync(StateKeyNameBasket);
            if (!string.IsNullOrEmpty(stateBasket))
            {
                _baskets = JsonSerializer.Deserialize<List<BasketModels>>(stateBasket) ?? new();
            } else
            {
                _baskets = new List<BasketModels>();
            }
            _sumPrice = _baskets.Sum(x => x.ProductPrice);
            StateHasChanged();
        }
    }
}