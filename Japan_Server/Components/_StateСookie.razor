@using Japan_Server.Services.IServices
@inject ILocalStorageService LocalStorageService

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    internal const string StateKeyNamePrice = "SumPrice";
    internal const string StateKeyNameImg = "ImgRoot";
    private string _imgRoot = "images/default.png";
    // надо делать список и передавать список, так как в корзине может быть несколько обектов
    public string ImgRoot
    {
        get => _imgRoot;
        set
        {
            _imgRoot = value;
            SaveStateImg();
        }
    }

    private void SaveStateImg()
    {
        var date = _imgRoot;
        LocalStorageService.SetStringAsync(StateKeyNameImg, date.ToString());
    }

    private double _sumPrice;
    public double SumPrice
    {
        get => _sumPrice;
        set
        {
            _sumPrice = value;
            StateHasChanged();
            SaveStatePrice();
        }
    }

    private void SaveStatePrice()
    {
        var date = _sumPrice;
        LocalStorageService.SetStringAsync(StateKeyNamePrice, date.ToString());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var statePrice = await LocalStorageService.GetStringAsync(StateKeyNamePrice);
        var stateImg = await LocalStorageService.GetStringAsync(StateKeyNameImg);
        if (statePrice != null)
        {
            _sumPrice = Convert.ToDouble(statePrice);
            _imgRoot = stateImg;
            StateHasChanged();
        }
    }
}